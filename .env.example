# Copy to .env and fill in locally. NEVER commit .env.

# --- AI provider (extraction + explanations). Set ONE of the two blocks; Gemini is used if both are set.
# Or force one with LLM_PROVIDER=gemini|anthropic ---
# Gemini (aistudio.google.com/apikey)
GEMINI_API_KEY=
# Gemini model id that accepts image and PDF input, e.g. gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash

# Anthropic (optional alternative)
ANTHROPIC_API_KEY=
# Any vision-capable Claude model id
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- PayPal SANDBOX (developer.paypal.com > Apps & Credentials > Sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox only. The app refuses to start payouts against any other host.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# ID of the webhook you create for your REST app (needed for signature verification)
PAYPAL_WEBHOOK_ID=

# --- Sandbox recipient (Personal) account emails, one per seeded NGO ---
NGO1_PAYPAL_EMAIL=
NGO2_PAYPAL_EMAIL=
NGO3_PAYPAL_EMAIL=

# --- App ---
# Default (if unset): ~/.fieldgrant/fieldgrant.sqlite, outside the repo so the dev server does not watch it
DATABASE_PATH=
# Default (if unset): ~/.fieldgrant/uploads
UPLOADS_DIR=
MAX_UPLOAD_BYTES=8388608
# Set to false to hide/disable the "Reset demo data" action on a public deployment
DEMO_RESET_ENABLED=true

# Optional: public repo URL. Shows the GitHub and Docs links on the landing page (hidden when unset).
NEXT_PUBLIC_GITHUB_URL=
